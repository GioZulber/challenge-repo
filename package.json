{
  "name": "challenge-tecnico",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": { "node": "^22.12 || ^24.0" },
  "scripts": {
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "gen:api": "pnpm --filter server gen:openapi && pnpm --filter client gen:api",
    "db:generate": "pnpm --filter server db:generate",
    "db:migrate": "pnpm --filter server db:migrate",
    "db:seed": "pnpm --filter server db:seed"
  }
}
