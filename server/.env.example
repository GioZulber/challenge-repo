# URL interna de PostgreSQL en Dokploy (solo para server, nunca para client).
# En desarrollo local usa una base PostgreSQL local, o un túnel seguro.
DATABASE_URL="postgresql://USER:PASSWORD@POSTGRES_INTERNAL_HOST:5432/DATABASE"

# Origen público del frontend, sin barra final; requerido en producción para login/logout.
CLIENT_ORIGIN="https://YOUR_CLIENT.vercel.app"

DEMO_EMAIL="soygranate@clublanus.com"
DEMO_PASSWORD="GRANATE1@"
