# URL PostgreSQL alcanzable desde Vercel (solo para server, nunca para client).
# En desarrollo local usa una base PostgreSQL local, o un túnel seguro.
DATABASE_URL="postgresql://USER:PASSWORD@POSTGRES_HOST_REACHABLE_FROM_VERCEL:5432/DATABASE"

# Origen público del frontend, sin barra final; requerido en producción para login/logout.
CLIENT_ORIGIN="https://YOUR_PROJECT.vercel.app"


